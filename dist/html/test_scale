<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Kyū Scale Test</title>
  <link rel="stylesheet" href="/css/unit.gl.css" />
  <style>
    body {
      font-family: sans-serif;
      padding: 2rem;
      background: #fff;
      color: #333;
    }

    section {
      margin-bottom: 4rem;
    }

    h2 {
      margin-bottom: 1rem;
      border-bottom: 1px solid #ddd;
    }

    .scale-demo {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .scale-line {
      background: #f9f9f9;
      border-left: 4px solid #eee;
      padding: 0.75rem 1rem;
      position: relative;
    }

    .scale-line::before {
      content: attr(data-label);
      position: absolute;
      left: 0.5rem;
      top: 0.5rem;
      font-size: 12px;
      color: #aaa;
    }
  </style>
</head>
<body>

  <h1>Scale Test: Typographic + Rhythmic</h1>

  <section>
    <h2>Typographic Scale</h2>
    <div class="scale-demo">
      <!-- Add these in a loop via Jinja or manually -->
      <div class="scale-line" style="font-size: var(--q4);" data-label="q4">The quick brown fox jumps.</div>
      <div class="scale-line" style="font-size: var(--q6);" data-label="q6"></div>
      <div class="scale-line" style="font-size: var(--q8);" data-label="q8"></div>
      <div class="scale-line" style="font-size: var(--q10);" data-label="q10"></div>
      <div class="scale-line" style="font-size: var(--q12);" data-label="q12"></div>
      <div class="scale-line" style="font-size: var(--q16);" data-label="q16"></div>
      <div class="scale-line" style="font-size: var(--q24);" data-label="q24"></div>
      <div class="scale-line" style="font-size: var(--q36);" data-label="q36"></div>
    </div>
  </section>

  <section>
    <h2>Baseline Scale (Vertical Rhythm)</h2>
    <div class="scale-demo">
      <div class="scale-line" style="height: calc(var(--q) * 5);" data-label="baseline(1)"></div>
      <div class="scale-line" style="height: calc(var(--q) * 10);" data-label="baseline(2)"></div>
      <div class="scale-line" style="height: calc(var(--q) * 15);" data-label="baseline(3)"></div>
      <div class="scale-line" style="height: calc(var(--q) * 20);" data-label="baseline(4)"></div>
    </div>
  </section>

  <section>
    <h2>Basepoint Scale</h2>
    <div class="scale-demo">
      <div class="scale-line" style="width: calc(var(--q) * 4);" data-label="basepoint(1)"></div>
      <div class="scale-line" style="width: calc(var(--q) * 8);" data-label="basepoint(2)"></div>
      <div class="scale-line" style="width: calc(var(--q) * 12);" data-label="basepoint(3)"></div>
      <div class="scale-line" style="width: calc(var(--q) * 16);" data-label="basepoint(4)"></div>
    </div>
  </section>

</body>
</html>
