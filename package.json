{
    "name": "unit.gl",
    "description": "Dynamic Layout Engine.",
    "version": "0.3.3",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "unit.gl",
        "unit",
        "kyu",
        "q",
        "stylescape",
        "sass",
        "typography",
        "fluid type",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.unit.gl/",
    "author": "Lars van Vianen <lars@vianen.com> (https://www.vianen.com)",
    "contributors": [
        "Scape Press <info@scape.press>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/unit.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/unit.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "./dist/js/index.cjs",
    "module": "./dist/js/index.mjs",
    "types": "./dist/js/index.d.ts",
    "sass": "src/scss/index.scss",
    "style": "dist/css/unit.gl.css",
    "scripts": {
        "build": "npx kist --config ./kist.yml && npm run build:ts && npm run docs:scss",
        "build:ts": "tsup",
        "docs:scss": "sassdoc src/scss --config .sassdocrc",
        "lint:scss": "stylelint \"src/scss/**/*.scss\"",
        "lint:scss:fix": "stylelint \"src/scss/**/*.scss\" --fix",
        "test:scss": "mocha test/scss.test.mjs",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@getkist/action-nunjucks": "^2.0.9",
        "@getkist/action-sass": "^1.0.4",
        "hue.gl": "^0.1.2",
        "kist": "^0.1.60",
        "micromatch": "^4.0.8",
        "mocha": "^11.7.5",
        "nunjucks": "^3.2.4",
        "sass": "^1.97.3",
        "sass-true": "^10.1.0",
        "sassdoc": "^2.7.4",
        "stylelint": "^17.11.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.1",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.13"
    },
    "overrides": {
        "webidl-conversions": "6.1.0"
    },
    "files": [
        "dist/**",
        "!dist/scss/dev/**",
        "!dist/scss/doc/**",
        "!dist/scss/test.scss",
        "!dist/scss/docs.scss",
        "!dist/css/unit.gl.docs.css",
        "!dist/css/unit.gl.docs.min.css",
        "!dist/html/**"
    ],
    "exports": {
        ".": {
            "sass": "./src/scss/index.scss",
            "types": "./dist/js/index.d.ts",
            "import": "./dist/js/index.mjs",
            "require": "./dist/js/index.cjs"
        },
        "./scss": "./dist/scss/index.scss",
        "./utilities": {
            "sass": "./dist/scss/utilities.scss"
        },
        "./tokens": {
            "sass": "./dist/scss/tokens.scss"
        },
        "./guide": {
            "sass": "./dist/scss/guide.scss"
        },
        "./formats": {
            "sass": "./dist/scss/formats.scss"
        },
        "./css/unit.gl.css": "./dist/css/unit.gl.css",
        "./css/unit.gl.min.css": "./dist/css/unit.gl.min.css"
    },
    "typesVersions": {
        "*": {
            "*": [
                "./ts/index.d.ts"
            ]
        }
    }
}
