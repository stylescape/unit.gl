{
    "name": "unit.gl",
    "description": "Dynamic Layout Engine.",
    "version": "0.3.1",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "unit.gl",
        "unit",
        "kyu",
        "q",
        "stylescape",
        "sass",
        "typography",
        "fluid type",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.unit.gl/",
    "author": "Lars van Vianen <lars@vianen.com> (https://www.vianen.com)",
    "contributors": [
        "Scape Agency <info@scape.agency>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/unit.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/unit.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "src/ts/index.ts",
    "sass": "src/scss/index.scss",
    "module": "dist/js/unit.gl.js",
    "style": "dist/css/unit.gl.css",
    "scripts": {
        "build": "npx kist --config ./kist.pro.yml",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "hue.gl": "^0.0.36",
        "kist": "^0.1.58",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.97.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "overrides": {
        "webidl-conversions": "6.1.0"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./scss/index.scss",
            "types": "./ts/index.d.ts",
            "import": "./js/unit.gl.js",
            "default": "./js/unit.gl.js"
        },
        "./utilities": {
            "sass": "./scss/utilities.scss"
        },
        "./guide": {
            "sass": "./scss/guide.scss"
        },
        "./formats": {
            "sass": "./scss/formats.scss"
        },
        "./css/unit.gl.css": "./css/unit.gl.css",
        "./css/unit.gl.min.css": "./css/unit.gl.min.css"
    },
    "typesVersions": {
        "*": {
            "*": [
                "./ts/index.d.ts"
            ]
        }
    }
}
