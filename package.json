{
    "name": "unit.gl",
    "description": "Dynamic Layout Engine.",
    "version": "0.1.4",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "unit.gl",
        "unit",
        "kyu",
        "q",
        "stylescape",
        "sass",
        "typography",
        "fluid type",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.unit.gl/",
    "author": "Lars van Vianen <lars@vianen.com> (https://www.vianen.com)",
    "contributors": [
        "Scape Agency <info@scape.agency>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/unit.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/unit.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "src/ts/index.ts",
    "sass": "src/scss/index.scss",
    "module": "dist/js/unit.gl.js",
    "style": "dist/css/unit.gl.css",
    "scripts": {
        "build": "npx kist --config ./kist.pro.yml",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite"
    },
    "devDependencies": {
        "kist": "^0.1.34",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.87.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "vite": "^6.3.5"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./scss/index.scss",
            "typescript": "./ts/index.ts"
        }
    }
