{#
    Base Template -- all pages extend this.

    Blocks:
    - title         Page title (rendered in <title>)
    - description   Meta description (rendered in <meta name="description">)
    - head_extra    Additional <head> content (per-page styles, scripts, meta)
    - header_class  Extra classes for the page header element
    - header        Page header content (eyebrow, h1, lead)
    - content       Main page content
    - footer_extra  Additional content rendered after the footer
#}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <title>{%- block title %}unit.gl{%- endblock %}</title>
    <meta name="description"
        content="{%- block description -%}A precision-based design system built on the Kyū (Q) unit for consistent, scalable spacing and typography.{%- endblock -%}" />
    {%- include "partials/head.html.jinja" %}
    {%- block head_extra %}{%- endblock %}
</head>

<body class="ss-l-page-sidebar-left">
    {# Skip to content link for accessibility #}
    <a href="#main" class="ss-c-skip-link">Skip to main content</a>

    {# Top bar #}
    {%- include "partials/nav.html.jinja" %}

    {# Grid Overlays #}
    {%- include "partials/grid-overlays.html.jinja" %}

    <div class="ss-l-page__body">
        {# Sidebar Navigation #}
        {%- include "partials/sidebar.html.jinja" %}

        <main id="main" class="ss-u-p-8">
            <header class="ss-c-demo__section__header {% block header_class %}{% endblock %}">
                {%- block header %}
                <p class="ss-t-overline">unit.gl</p>
                <h1>Documentation</h1>
                {%- endblock %}
            </header>

            {# Fallback for users without JavaScript #}
            <noscript>
                <div class="ss-c-alert ss-c-alert--warning">
                    <p class="ss-c-alert__body"><strong>JavaScript Required:</strong> Some interactive features on
                        this page require JavaScript to function properly.</p>
                </div>
            </noscript>

            <div class="ss-u-prose">
                {%- block content %}
                <p>Replace this with your content.</p>
                {%- endblock %}
            </div>
        </main>
    </div>

    {# Footer #}
    {%- include "partials/footer.html.jinja" %}
    {%- block footer_extra %}{%- endblock %}
</body>
</html>
