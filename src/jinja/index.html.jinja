{% extends "base.html.jinja" %}
{% from "partials/components.html.jinja" import feature_card, button, number_cell, doc_section %}
{% from "partials/icons.html.jinja" import icon_lightning, icon_github %}

{%- block title %}unit.gl — Dynamic Layout Engine{%- endblock %}

{%- block header_class %}header--hero{%- endblock %}

{%- block header %}
<p class="eyebrow">Dynamic Layout Engine</p>
<h1>unit.gl</h1>
<p class="lead">A precision-based design system built on the Kyū (Q) unit — enabling consistent, scalable spacing and
    typography across digital and print.</p>
<div class="hero-actions">
    {{ button('Get Started', href='/getting-started.html', variant='primary', icon='lightning') }}
    {{ button('View on GitHub', href='https://github.com/stylescape/unit.gl', variant='secondary', icon='github',
    target='_blank') }}
</div>
{%- endblock %}

{%- block content %}

{# Key Features #}
<section>
    <h2>Features</h2>
    <div class="feature-grid">
        {{ feature_card('Q', 'The Q Unit', 'Atomic unit system based on 0.0625rem (1px). Every measurement derives from
        this precise foundation.') }}
        {{ feature_card('⊞', '8-Point Grid', 'Enforces spatial harmony with consistent multiples. Elements snap to a
        uniform rhythm.') }}
        {{ feature_card('φ', 'Modular Scale', 'Typography system using mathematical ratios. Golden ratio, Major Third,
        and more.') }}
        {{ feature_card('⬚', 'Utility Classes', 'Tailwind-style classes for rapid prototyping. Spacing, sizing, and
        responsive variants.') }}
        {{ feature_card('◈', 'Aspect Ratios', 'Pre-defined ratios for images, videos, and containers. From square to
        ultrawide.') }}
        {{ feature_card('≡', 'Layer System', 'Semantic z-index management. No more magic numbers for stacking
        contexts.') }}
    </div>
</section>

<!-- Quick Start -->
<section>
    <h2>Quick Start</h2>
    <div class="code-block"><span class="comment">// Install via npm</span>
        npm install unit.gl

        <span class="comment">// Import in your SCSS</span>
        @use "unit.gl" as *;

        <span class="comment">// Use the q() function for precise spacing</span>
        .card {
        padding: <span class="class">q(16)</span>; <span class="comment">// 1rem (16px)</span>
        margin: <span class="class">q(8)</span>; <span class="comment">// 0.5rem (8px)</span>
        gap: <span class="class">q(4)</span>; <span class="comment">// 0.25rem (4px)</span>
        }

        <span class="comment">// Or use utility classes directly</span>
        &lt;div class="<span class="class">p_q16 m_q8 gap_q4</span>"&gt;...&lt;/div&gt;
    </div>
    <a href="/getting-started.html" class="btn btn--secondary" style="margin-top: 16px;">Full Installation Guide →</a>
</section>

{# Documentation Sections #}
<section>
    <h2>Documentation</h2>

    <div class="doc-sections">
        {{ doc_section('Learn', [
        {'href': '/getting-started.html', 'label': 'Getting Started'},
        {'href': '/core-concepts.html', 'label': 'Core Concepts'},
        {'href': '/configuration.html', 'label': 'Configuration'}
        ]) }}
        {{ doc_section('API Reference', [
        {'href': '/functions.html', 'label': 'Functions'},
        {'href': '/mixins.html', 'label': 'Mixins'},
        {'href': '/test_breakpoints.html', 'label': 'Breakpoints'},
        {'href': '/test_device.html', 'label': 'Device Explorer'},
        {'href': '/test_paper.html', 'label': 'Page Formats'},
        {'href': '/test_utilities.html', 'label': 'Utility Classes'}
        ]) }}
        {{ doc_section('Guides', [
        {'href': '/scale.html', 'label': 'Scale System'},
        {'href': '/test_ratio.html', 'label': 'Aspect Ratios'},
        {'href': '/test_layers.html', 'label': 'Layer System'},
        {'href': '/guide_baseline.html', 'label': 'Baseline Grid'}
        ]) }}
    </div>
</section>

{# The Q Unit #}
<section>
    <h2>The Q Unit</h2>
    <p>The foundation of unit.gl is the <strong>Kyū (Q)</strong> — a base unit equal to <code>0.0625rem</code> (1px at
        16px root). All spacing, sizing, and typography derive from this atomic measurement.</p>

    <div class="number-grid" style="margin-top: 24px;">
        {% for step in [1, 2, 4, 8, 16, 32, 64, 128] %}
        {{ number_cell(step) }}
        {% endfor %}
    </div>
    {{ button('Learn More →', href='/core-concepts.html', variant='secondary') }}
</section>

<!-- Demos -->
<section>
    <h2>Live Demos</h2>

    {% set demos = [
    {"name": "test_breakpoints", "title": "Breakpoints", "tag": "responsive", "desc": "Interactive view of $breakpoints
    (includes ss)"},
    {"name": "test_device", "title": "Device Explorer", "tag": "media", "desc": "Detect media features + match $devices
    profiles"},
    {"name": "test_paper", "title": "Page Formats", "tag": "print", "desc": "Explore Q-series formats (res/) and
    format()
    usage"},
    {"name": "test_qscale", "title": "Q Scale Explorer", "tag": "units", "desc": "Interactively explore q() and the
    $q_steps ladder"},
    {"name": "test_utilities", "title": "Utility Classes", "tag": "interactive", "desc": "Explore spacing, sizing, and
    responsive utilities"},
    {"name": "test_scale", "title": "Typographic Scale", "tag": "typography", "desc": "See modular scale ratios in
    action"},
    {"name": "test_ratio", "title": "Aspect Ratios", "tag": "layout", "desc": "Visual demonstration of all ratio
    presets"},
    {"name": "test_layers", "title": "Layer System", "tag": "z-index", "desc": "Interactive stacking context
    visualization"},
    {"name": "guide_baseline", "title": "Baseline Grid", "tag": "guides", "desc": "Toggle alignment guides and grids"}
    ] %}

    <ul>
        {% for page in demos %}
        <li>
            <div class="list-item">
                <div>
                    <a href="/{{ page.name }}.html" class="list-item__title">{{ page.title }}</a>
                    <span class="tag{% if page.tag == 'interactive' %} tag--red{% endif %}">{{ page.tag }}</span>
                    <p class="list-item__meta" style="margin-top: 4px; margin-bottom: 0;">{{ page.desc }}</p>
                </div>
                <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--swiss-gray-400);">→</span>
            </div>
        </li>
        {% endfor %}
    </ul>
</section>

{%- endblock %}
