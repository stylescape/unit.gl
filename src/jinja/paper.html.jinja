{% extends "base.html.jinja" %}

{%- block title %}Page Formats — unit.gl{%- endblock %}

{%- block header %}
<p class="eyebrow">Print</p>
<h1>Page Formats</h1>
<p class="lead">Explore the Q-series page formats and compare them to international standards (ISO A, US Letter).</p>
{%- endblock %}

{%- block content %}

<div class="page--paper">

    {% set q_formats = [
    {"key": "q12", "w": 11.25, "h": 15.625},
    {"key": "q11", "w": 15.625, "h": 22.5},
    {"key": "q10", "w": 22.5, "h": 31.25},
    {"key": "q09", "w": 31.25, "h": 45.0},
    {"key": "q08", "w": 45.0, "h": 62.5},
    {"key": "q07", "w": 62.5, "h": 90.0},
    {"key": "q06", "w": 90.0, "h": 135.0},
    {"key": "q05", "w": 135.0, "h": 180.0},
    {"key": "q04", "w": 180.0, "h": 270.0},
    {"key": "q03", "w": 270.0, "h": 360.0},
    {"key": "q02", "w": 360.0, "h": 540.0},
    {"key": "q01", "w": 540.0, "h": 720.0},
    {"key": "q00", "w": 720.0, "h": 1080.0},
    {"key": "q00+", "w": 1080.0, "h": 1440.0},
    {"key": "q00++", "w": 1440.0, "h": 2160.0}
    ] %}

    {% set iso_formats = [
    {"key": "a10", "w": 26, "h": 37},
    {"key": "a9", "w": 37, "h": 52},
    {"key": "a8", "w": 52, "h": 74},
    {"key": "a7", "w": 74, "h": 105},
    {"key": "a6", "w": 105, "h": 148},
    {"key": "a5", "w": 148, "h": 210},
    {"key": "a4", "w": 210, "h": 297},
    {"key": "a3", "w": 297, "h": 420},
    {"key": "a2", "w": 420, "h": 594},
    {"key": "a1", "w": 594, "h": 841},
    {"key": "a0", "w": 841, "h": 1189}
    ] %}

    {% set us_formats = [
    {"key": "letter", "w": 215.9, "h": 279.4},
    {"key": "legal", "w": 215.9, "h": 355.6},
    {"key": "tabloid", "w": 279.4, "h": 431.8},
    {"key": "executive", "w": 184.15, "h": 266.7}
    ] %}

    {% set all_formats = q_formats + iso_formats + us_formats %}

    <section>
        <h2>Interactive Preview</h2>
        <p class="paper-muted">Compare formats at true relative scale. All sizes shown proportionally to each other.</p>

        <div class="paper-controls">
            <label class="paper-field">
                <span class="paper-field__label">Format</span>
                <select id="paper-format" class="paper-select" aria-label="Page format">
                    <optgroup label="Q-Series">
                        {% for f in q_formats %}
                        <option value="{{ f.key }}" data-w="{{ f.w }}" data-h="{{ f.h }}">{{ f.key }}</option>
                        {% endfor %}
                    </optgroup>
                    <optgroup label="ISO A-Series">
                        {% for f in iso_formats %}
                        <option value="{{ f.key }}" data-w="{{ f.w }}" data-h="{{ f.h }}">{{ f.key | upper }}</option>
                        {% endfor %}
                    </optgroup>
                    <optgroup label="US Formats">
                        {% for f in us_formats %}
                        <option value="{{ f.key }}" data-w="{{ f.w }}" data-h="{{ f.h }}">{{ f.key | capitalize }}
                        </option>
                        {% endfor %}
                    </optgroup>
                </select>
            </label>

            <div class="paper-orient" role="group" aria-label="Orientation">
                <button type="button" class="paper-orient__btn active" data-orient="portrait">Portrait</button>
                <button type="button" class="paper-orient__btn" data-orient="landscape">Landscape</button>
            </div>
        </div>

        <div class="paper-preview-wrap">
            <div class="paper-preview-container" id="paper-preview-container">
                <div class="paper-preview" id="paper-preview" aria-label="Page preview">
                    <div class="paper-preview__meta">
                        <div class="paper-preview__title" id="paper-title">q04</div>
                        <div class="paper-preview__dims"><span id="paper-w">—</span> × <span id="paper-h">—</span> mm
                        </div>
                    </div>
                </div>
            </div>
            <div class="paper-scale-indicator">
                <span id="scale-display">Scale: 1:1</span>
            </div>
        </div>

        <div class="code-block">
            <pre><code>// SCSS
.print-sheet {
  @include format(q04, portrait);
}</code></pre>
        </div>
    </section>

    <section>
        <h2>Format Comparison</h2>
        <p class="paper-muted">Visual comparison of Q-series against ISO A and US formats at relative scale.</p>

        <div class="comparison-grid">
            <div class="comparison-column">
                <h3 class="comparison-heading">Q-Series</h3>
                <p class="comparison-desc">Based on 1:1.5 ratio (2:3). Optimized for screen and modular grids.</p>
                <div class="comparison-stack" id="q-stack">
                    {% for f in q_formats %}
                    {% if f.key in ['q06', 'q05', 'q04', 'q03', 'q02'] %}
                    <div class="comparison-sheet comparison-sheet--q" data-key="{{ f.key }}" data-w="{{ f.w }}"
                        data-h="{{ f.h }}" title="{{ f.key }}: {{ f.w }}×{{ f.h }}mm">
                        <span class="comparison-sheet__label">{{ f.key }}</span>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="comparison-column">
                <h3 class="comparison-heading">ISO A-Series</h3>
                <p class="comparison-desc">Based on √2 ratio (~1:1.414). International standard for print.</p>
                <div class="comparison-stack" id="a-stack">
                    {% for f in iso_formats %}
                    {% if f.key in ['a6', 'a5', 'a4', 'a3', 'a2'] %}
                    <div class="comparison-sheet comparison-sheet--a" data-key="{{ f.key }}" data-w="{{ f.w }}"
                        data-h="{{ f.h }}" title="{{ f.key | upper }}: {{ f.w }}×{{ f.h }}mm">
                        <span class="comparison-sheet__label">{{ f.key | upper }}</span>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="comparison-column">
                <h3 class="comparison-heading">US Formats</h3>
                <p class="comparison-desc">Imperial-based sizes. Common in North America.</p>
                <div class="comparison-stack" id="us-stack">
                    {% for f in us_formats %}
                    <div class="comparison-sheet comparison-sheet--us" data-key="{{ f.key }}" data-w="{{ f.w }}"
                        data-h="{{ f.h }}" title="{{ f.key | capitalize }}: {{ f.w }}×{{ f.h }}mm">
                        <span class="comparison-sheet__label">{{ f.key | capitalize }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <section>
        <h2>Ratio Comparison</h2>
        <p class="paper-muted">Key differences between format systems.</p>

        <table class="paper-table">
            <thead>
                <tr>
                    <th>System</th>
                    <th>Ratio</th>
                    <th>Decimal</th>
                    <th>Common Sizes</th>
                    <th>Best For</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Q-Series</strong></td>
                    <td><code>2:3</code></td>
                    <td><code>1.500</code></td>
                    <td>Q04, Q03, Q02</td>
                    <td>Screens, modular layouts, photography</td>
                </tr>
                <tr>
                    <td><strong>ISO A</strong></td>
                    <td><code>1:√2</code></td>
                    <td><code>1.414</code></td>
                    <td>A4, A3, A5</td>
                    <td>International print, folding sheets</td>
                </tr>
                <tr>
                    <td><strong>US Letter</strong></td>
                    <td><code>17:22</code></td>
                    <td><code>1.294</code></td>
                    <td>Letter, Legal</td>
                    <td>North American office documents</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section>
        <h2>Q-Series Reference</h2>
        <p class="paper-muted">Complete Q-series formats from <code>res/paper_size_metric_q.csv</code>.</p>

        <table class="paper-table">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Width (mm)</th>
                    <th>Height (mm)</th>
                    <th>Area (cm²)</th>
                    <th>~Equivalent</th>
                </tr>
            </thead>
            <tbody>
                {% for f in q_formats %}
                <tr>
                    <td><code>{{ f.key }}</code></td>
                    <td><code>{{ f.w }}</code></td>
                    <td><code>{{ f.h }}</code></td>
                    <td class="paper-usage">{{ ((f.w * f.h) / 100) | round(1) }}</td>
                    <td class="paper-usage">
                        {% if f.key == 'q04' %}≈ A5
                        {% elif f.key == 'q03' %}≈ A4
                        {% elif f.key == 'q02' %}≈ A3
                        {% elif f.key == 'q05' %}≈ A6
                        {% elif f.key == 'q01' %}≈ A2
                        {% elif f.key == 'q00' %}≈ A1
                        {% else %}—
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section>
        <h2>ISO A-Series Reference</h2>
        <p class="paper-muted">International standard paper sizes (ISO 216).</p>

        <table class="paper-table">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Width (mm)</th>
                    <th>Height (mm)</th>
                    <th>Area (cm²)</th>
                </tr>
            </thead>
            <tbody>
                {% for f in iso_formats %}
                <tr>
                    <td><code>{{ f.key }}</code></td>
                    <td><code>{{ f.w }}</code></td>
                    <td><code>{{ f.h }}</code></td>
                    <td class="paper-usage">{{ ((f.w * f.h) / 100) | round(1) }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <div class="alert alert--tip" style="margin-top: calc(var(--grid-unit) * 3);">
        <div class="alert__title">Custom formats</div>
        <p>Extend formats using Sass configuration:</p>
        <div class="code-block">
            <pre><code>@use "unit.gl" with (
  $format_overrides: (
    "my-format": (100mm, 200mm)
  )
);

.sheet { @include format("my-format"); }</code></pre>
        </div>
    </div>

</div>

{%- endblock %}
