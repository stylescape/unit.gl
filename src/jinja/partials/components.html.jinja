{#
Reusable UI Components as Jinja macros
Usage: {% from "partials/components.html.jinja" import code_block, alert, api_signature %}
#}

{# ============================================================================
Code Block
Usage: {{ code_block('npm install unit.gl', lang='bash') }}
============================================================================ #}
{% macro code_block(code, lang='scss', title='') %}
{% if title %}<p class="ss-t-label">{{ title }}</p>{% endif %}
<pre class="ss-c-code-block"{% if lang %} data-lang="{{ lang }}"{% endif %}>{{ code | safe }}</pre>
{% endmacro %}


{# ============================================================================
Alert / Callout
Usage: {{ alert('This is a tip!', type='tip', title='Pro Tip') }}
Types: tip, warning, info, danger (tip renders as stylescape's success alert)
============================================================================ #}
{% macro alert(content, type='info', title='') %}
{%- set variants = {'tip': 'success', 'info': 'info', 'warning': 'warning', 'danger': 'danger'} -%}
<div class="ss-c-alert ss-c-alert--{{ variants[type] or 'info' }}">
    <div class="ss-c-alert__body">
        {% if title %}<p class="ss-c-alert__title">{{ title }}</p>{% endif %}
        <p>{{ content | safe }}</p>
    </div>
</div>
{% endmacro %}


{# ============================================================================
API Signature
Usage: {{ api_signature('q($multiplier) → Length') }}
============================================================================ #}
{% macro api_signature(signature) %}
<pre class="ss-c-code-block">{{ signature }}</pre>
{% endmacro %}


{# ============================================================================
API Parameter
Usage: {{ api_param('$multiplier', 'Number', 'The number of Q units') }}
============================================================================ #}
{% macro api_param(name, type, description, default='') %}
<tr>
    <td><code>{{ name }}</code></td>
    <td><span class="ss-c-badge ss-c-badge--sm">{{ type }}</span></td>
    <td>{{ description }}{% if default %} <em>Default: {{ default }}</em>{% endif %}</td>
</tr>
{% endmacro %}


{# ============================================================================
API Parameters Block
Usage: {% call api_params() %}{{ api_param(...) }}{% endcall %}
============================================================================ #}
{% macro api_params() %}
<table class="ss-c-table">
    <thead>
        <tr>
            <th>Parameter</th>
            <th>Type</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        {{ caller() }}
    </tbody>
</table>
{% endmacro %}


{# ============================================================================
Feature Card
Usage: {{ feature_card('Q', 'The Q Unit', 'Atomic unit system...') }}
============================================================================ #}
{% macro feature_card(icon, title, description) %}
<div class="ss-c-card">
    <div class="ss-c-card__icon" aria-hidden="true">{{ icon }}</div>
    <h3 class="ss-c-card__title">{{ title }}</h3>
    <p class="ss-c-card__description">{{ description }}</p>
</div>
{% endmacro %}


{# ============================================================================
Button
Usage: {{ button('Get Started', href='/start.html', variant='primary', icon='lightning') }}
Variants: primary, secondary, ghost (mapped to stylescape's solid, outline, ghost)
Icons: lightning, github, arrow, external
============================================================================ #}
{% macro button(text, href='#', variant='primary', icon='', target='') %}
{%- from "partials/icons.html.jinja" import icon_lightning, icon_github, icon_arrow_right, icon_external -%}
{%- set leading_icons = {'lightning': icon_lightning, 'github': icon_github, 'arrow': icon_arrow_right} -%}
{%- set trailing_icons = {'external': icon_external} -%}
{%- set variants = {'primary': 'solid', 'secondary': 'outline', 'ghost': 'ghost'} -%}
<a href="{{ href }}" class="ss-c-button ss-c-button--{{ variants[variant] or 'solid' }}" {%- if target %} target="{{ target }}" rel="noopener noreferrer" {%
    endif %}>
    {%- if icon in leading_icons %}{{ leading_icons[icon]() }}{% endif %}
    {{ text }}
    {%- if icon in trailing_icons %}{{ trailing_icons[icon]() }}{% endif %}
</a>
{% endmacro %}


{# ============================================================================
Demo Row
Usage: {% call demo_row() %}...{% endcall %}
============================================================================ #}
{% macro demo_row() %}
<div class="ss-c-demo__group">
    {{ caller() }}
</div>
{% endmacro %}


{# ============================================================================
Demo Item
Usage: {{ demo_item(content, label='.p_q16') }}
============================================================================ #}
{% macro demo_item(label='') %}
<div class="ss-c-demo__stack">
    {{ caller() }}
    {% if label %}<span class="ss-t-label">{{ label }}</span>{% endif %}
</div>
{% endmacro %}


{# ============================================================================
Table (simple)
Usage: {{ table(headers=['Name', 'Value'], rows=[['item1', 'val1'], ['item2', 'val2']]) }}
============================================================================ #}
{% macro table(headers, rows, class='') %}
<table class="ss-c-table{% if class %} {{ class }}{% endif %}">
    <thead>
        <tr>
            {% for header in headers %}
            <th>{{ header }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
        <tr>
            {% for cell in row %}
            <td>{{ cell | safe }}</td>
            {% endfor %}
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endmacro %}


{# ============================================================================
Section Header
Usage: {{ section_header('Features', 'Explore the key features of unit.gl') }}
============================================================================ #}
{% macro section_header(title, description='') %}
<h2>{{ title }}</h2>
{% if description %}<p>{{ description }}</p>{% endif %}
{% endmacro %}


{# ============================================================================
Ratio Card
Usage: {{ ratio_card('1:1', 'Square', 1, 1) }}
============================================================================ #}
{% macro ratio_card(name, desc, w, h) %}
<div class="ratio-card">
    <div class="ratio-card__preview" style="aspect-ratio: {{ w }}/{{ h }};">
        <span class="ratio-card__inner">{{ w }}:{{ h }}</span>
    </div>
    <div class="ratio-card__info">
        <p class="ratio-card__name">{{ desc }}</p>
        <p class="ratio-card__value">.ratio_{{ w }}x{{ h }}</p>
    </div>
</div>
{% endmacro %}


{# ============================================================================
Number Cell (for Q unit grids)
Usage: {{ number_cell(16) }}
============================================================================ #}
{% macro number_cell(value) %}
<div class="number-cell">
    <div class="number-cell__value">{{ value }}</div>
    <div class="number-cell__label">q({{ value }})</div>
</div>
{% endmacro %}


{# ============================================================================
Doc Section (for documentation index)
Usage: {{ doc_section('Learn', [{'href': '/start.html', 'label': 'Getting Started'}]) }}
============================================================================ #}
{% macro doc_section(title, links) %}
<div class="ss-c-card">
    <h3 class="ss-c-card__title">{{ title }}</h3>
    <ul>
        {% for link in links %}
        <li><a href="{{ link.href }}">{{ link.label }}</a></li>
        {% endfor %}
    </ul>
</div>
{% endmacro %}
