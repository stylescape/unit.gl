{#
Footer partial.

Variables (provided by kist context, overridable per-page):
- brand Brand name (default: "unit.gl")
- tagline Tagline text (default: "Dynamic Layout Engine")
- year Copyright year (default: 2026)
#}

<footer class="ss-c-footer">
    <div class="ss-c-footer-container ss-c-footer-bottom">
        <div class="ss-c-footer-brand-section">
            <span class="ss-c-footer-brand-name">{{ brand | default('unit.gl') }}</span>
            <span class="ss-c-footer-copyright">{{ tagline | default('Dynamic Layout Engine') }}</span>
        </div>
        <nav class="ss-c-footer-legal" aria-label="Project links">
            <a href="https://github.com/stylescape/unit.gl" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://www.npmjs.com/package/unit.gl" target="_blank" rel="noopener noreferrer">npm</a>
            <a href="https://www.scape.press" target="_blank" rel="noopener noreferrer">Scape Press</a>
        </nav>
        <p class="ss-c-footer-copyright">© {{ year | default('2026') }} Scape Press. MIT License.</p>
    </div>
</footer>
