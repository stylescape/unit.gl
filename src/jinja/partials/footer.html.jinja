{#
Footer partial.

Variables (provided by kist context, overridable per-page):
- brand Brand name (default: "unit.gl")
- tagline Tagline text (default: "Dynamic Layout Engine")
- year Copyright year (default: 2026)
#}

<footer class="footer">
    <div class="footer__content">
        <div class="footer__left">
            <span class="footer__brand">{{ brand | default('unit.gl') }}</span>
            <span class="footer__tagline">{{ tagline | default('Dynamic Layout Engine') }}</span>
        </div>
        <div class="footer__right">
            <div class="footer__links">
                <a href="https://github.com/stylescape/unit.gl" class="footer__link" target="_blank"
                    rel="noopener noreferrer">GitHub</a>
                <a href="https://www.npmjs.com/package/unit.gl" class="footer__link" target="_blank"
                    rel="noopener noreferrer">npm</a>
                <a href="https://www.scape.press" class="footer__link" target="_blank" rel="noopener noreferrer">Scape
                    Press</a>
            </div>
            <span class="footer__copyright">© {{ year | default('2026') }} Scape Press. MIT License.</span>
        </div>
    </div>
</footer>
