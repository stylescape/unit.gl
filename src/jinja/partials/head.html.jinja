{#
Head partial -- static

<head> contents (assets, fonts, theme color).

    Page-specific <title> and
        <meta name="description"> live in base.html.jinja
        so individual pages can override them via Jinja blocks.

        Variables:
        - canonical_url Optional canonical URL
        #}
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
        {% if canonical_url %}
        <link rel="canonical" href="{{ canonical_url }}" />{% endif %}

        {# Stylesheets
        stylescape (dev-only, served from node_modules by vite.config.js) styles
        the demo chrome. The local unit.gl build loads after it, imported into
        a cascade layer ordered beneath stylescape's: unit.gl.css ships an
        unlayered universal reset (`* { margin: 0; padding: 0 }`) that would
        otherwise beat every layered stylescape rule. #}
        <style>
            @layer unitgl, ss;
        </style>
        <link rel="stylesheet" href="/vendor/stylescape/stylescape.css" />
        <style>
            @import url("/css/unit.gl.css") layer(unitgl);
        </style>
        <link rel="stylesheet" href="/css/unit.gl.docs.css" />

        {# Scripts #}
        <script type="module" src="/js/unit.gl.js"></script>
        <script src="/js/unit.gl.docs.js"></script>
