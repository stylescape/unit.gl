{#
Head partial - Contains all

<head> content

    Variables:
    - title: Page title (default: "unit.gl")
    - description: Meta description (optional)
    #}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description"
        content="{{ description | default('A precision-based design system built on the Kyū (Q) unit for consistent, scalable spacing and typography.') }}" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{{ title | default('unit.gl') }}</title>

    {# Stylesheets #}
    <link rel="stylesheet" href="/css/unit.gl.css" />
    <link rel="stylesheet" href="/css/unit.gl.docs.css" />

    {# Scripts #}
    <script type="module" src="/js/unit.gl.js"></script>
    <script src="/js/unit.gl.docs.js"></script>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
