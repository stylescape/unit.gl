{#
Head partial -- static

<head> contents (assets, fonts, theme color).

    Page-specific <title> and
        <meta name="description"> live in base.html.jinja
        so individual pages can override them via Jinja blocks.

        Variables:
        - canonical_url Optional canonical URL
        #}
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
        {% if canonical_url %}
        <link rel="canonical" href="{{ canonical_url }}" />{% endif %}

        {# Stylesheets #}
        <link rel="stylesheet" href="/css/unit.gl.css" />
        <link rel="stylesheet" href="/css/unit.gl.docs.css" />

        {# Scripts #}
        <script type="module" src="/js/unit.gl.js"></script>
        <script src="/js/unit.gl.docs.js"></script>

        {# Fonts #}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
