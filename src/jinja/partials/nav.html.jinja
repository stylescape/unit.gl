{#
Navigation partial - Top bar only (sidebar handles docs navigation)

Variables:
- version: Version string to display (default: "v0.1")
- current_page: Current page filename for active state (e.g., 'index.html')
#}
{% from "partials/icons.html.jinja" import icon_sun, icon_moon, icon_baseline, icon_graph, icon_github, icon_menu,
icon_close %}

<div class="nav-wrapper">
    <nav class="nav" aria-label="Main navigation">
        <div class="nav__inner">
            {# Logo #}
            <a href="index.html" class="nav__logo" {% if current_page=='index.html' %}aria-current="page" {% endif %}>
                <span class="nav__logo-text">unit.gl</span>
                <span class="nav__version">{{ version | default('v0.1') }}</span>
            </a>

            {# Mobile Sidebar Toggle #}
            <button type="button" class="nav__mobile-toggle" id="sidebar-toggle" aria-expanded="false"
                aria-controls="sidebar" aria-label="Toggle navigation menu">
                {{ icon_menu() }}
                {{ icon_close() }}
            </button>

            <div class="nav__right">
                {# Current Breakpoint Indicator #}
                <div class="nav__bp" id="nav-bp" title="Current viewport breakpoint" aria-live="polite">
                    <span class="nav__bp-key" id="nav-bp-key">—</span>
                    <span class="nav__bp-width" id="nav-bp-width">—px</span>
                </div>

                {# Current q(1) px Value #}
                <div class="nav__bp" id="nav-q" title="Computed pixel value of q(1) at the current root font size"
                    aria-live="polite">
                    <span class="nav__bp-key">q(1)</span>
                    <span class="nav__bp-width" id="nav-q-px">—px</span>
                </div>

                {# Grid Controls #}
                <div class="grid-controls" aria-label="Grid overlay controls">
                    <button type="button" data-toggle="baseline" title="Toggle baseline grid" aria-pressed="false">
                        {{ icon_baseline() }}
                        <span>Baseline</span>
                    </button>
                    <button type="button" data-toggle="graph" title="Toggle graph grid" aria-pressed="false">
                        {{ icon_graph() }}
                        <span>Graph</span>
                    </button>
                </div>

                {# Theme Toggle #}
                <button type="button" class="theme-toggle" data-toggle="theme" title="Toggle dark mode"
                    aria-label="Toggle dark mode">
                    {{ icon_sun() }}
                    {{ icon_moon() }}
                </button>

                {# GitHub Link #}
                <a href="https://github.com/stylescape/unit.gl" class="nav__github" target="_blank"
                    rel="noopener noreferrer" title="View on GitHub" aria-label="View on GitHub (opens in new tab)">
                    {{ icon_github() }}
                </a>
            </div>
        </div>
    </nav>
</div>
