{#
Navigation partial

Variables:
- version: Version string to display (default: "v0.1")
- current_page: Current page filename for active state (e.g., 'index.html')
- nav_items: Optional custom navigation items
#}
{% from "partials/icons.html.jinja" import icon_sun, icon_moon, icon_baseline, icon_graph, icon_chevron_down,
icon_github, icon_menu, icon_close %}

{# Navigation Structure Data #}
{% set default_nav = {
'learn': [
{'href': 'getting-started.html', 'label': 'Getting Started'},
{'href': 'core-concepts.html', 'label': 'Core Concepts'},
{'href': 'configuration.html', 'label': 'Configuration'}
],
'api': [
{'href': 'functions.html', 'label': 'Functions'},
{'href': 'mixins.html', 'label': 'Mixins'},
{'href': 'layers.html', 'label': 'Layers'},
{'href': 'density.html', 'label': 'Density'}
],
'demos': [
{'href': 'test_hybrid_scale.html', 'label': 'Hybrid Scale'},
{'href': 'test_breakpoints.html', 'label': 'Breakpoints'},
{'href': 'test_device.html', 'label': 'Devices'},
{'href': 'test_qscale.html', 'label': 'Q Scale'},
{'href': 'test_paper.html', 'label': 'Formats'},
{'href': 'test_utilities.html', 'label': 'Utilities'},
{'href': 'test_ratio.html', 'label': 'Ratios'},
{'href': 'test_scale.html', 'label': 'Scale'},
{'href': 'test_lorem.html', 'label': 'Typography'}
],
'about': [
{'href': 'background.html', 'label': 'Background'}
]
} %}

{% set nav = nav_items | default(default_nav) %}

<div class="nav-wrapper">
    <nav class="nav" aria-label="Main navigation">
        <div class="nav__inner">
            {# Logo #}
            <a href="index.html" class="nav__logo" {% if current_page == 'index.html' %}aria-current="page"{% endif %}>
                <span class="nav__logo-text">unit.gl</span>
                <span class="nav__version">{{ version | default('v0.1') }}</span>
            </a>

            {# Mobile Menu Toggle #}
            <button type="button" class="nav__mobile-toggle" id="nav-mobile-toggle" 
                    aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle navigation menu">
                {{ icon_menu() }}
                {{ icon_close() }}
            </button>

            <div class="nav__right" id="nav-menu">
                {# Grid Controls #}
                <div class="grid-controls" aria-label="Grid overlay controls">
                    <button type="button" data-toggle="baseline" title="Toggle baseline grid" aria-pressed="false">
                        {{ icon_baseline() }}
                        <span>Baseline</span>
                    </button>
                    <button type="button" data-toggle="graph" title="Toggle graph grid" aria-pressed="false">
                        {{ icon_graph() }}
                        <span>Graph</span>
                    </button>
                </div>

                {# Theme Toggle #}
                <button type="button" class="theme-toggle" data-toggle="theme" title="Toggle dark mode"
                    aria-label="Toggle dark mode">
                    {{ icon_sun() }}
                    {{ icon_moon() }}
                </button>

                {# Docs Dropdown #}
                <div class="nav__dropdown" id="nav-dropdown">
                    <button type="button" class="nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                        <span>Docs</span>
                        {{ icon_chevron_down() }}
                    </button>
                    <div class="nav__dropdown-menu" role="menu">
                        <div class="nav__dropdown-section">
                            <span class="nav__dropdown-label">Learn</span>
                            {% for item in nav.learn %}
                            <a href="{{ item.href }}" role="menuitem" {% if current_page == item.href %}aria-current="page" class="is-active"{% endif %}>{{ item.label }}</a>
                            {% endfor %}
                        </div>
                        <div class="nav__dropdown-section">
                            <span class="nav__dropdown-label">API</span>
                            {% for item in nav.api %}
                            <a href="{{ item.href }}" role="menuitem" {% if current_page == item.href %}aria-current="page" class="is-active"{% endif %}>{{ item.label }}</a>
                            {% endfor %}
                        </div>
                        <div class="nav__dropdown-section">
                            <span class="nav__dropdown-label">Demos</span>
                            {% for item in nav.demos %}
                            <a href="{{ item.href }}" role="menuitem" {% if current_page == item.href %}aria-current="page" class="is-active"{% endif %}>{{ item.label }}</a>
                            {% endfor %}
                        </div>
                        <div class="nav__dropdown-section">
                            <span class="nav__dropdown-label">About</span>
                            {% for item in nav.about %}
                            <a href="{{ item.href }}" role="menuitem" {% if current_page == item.href %}aria-current="page" class="is-active"{% endif %}>{{ item.label }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# GitHub Link #}
                <a href="https://github.com/stylescape/unit.gl" class="nav__github" target="_blank"
                    rel="noopener noreferrer" title="View on GitHub" aria-label="View on GitHub (opens in new tab)">
                    {{ icon_github() }}
                </a>
            </div>
        </div>
    </nav>
</div>
