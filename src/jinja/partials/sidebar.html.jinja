{#
Sidebar Navigation partial

Variables:
- current_page: Current page filename for active state (e.g., 'index.html')
#}

{# Navigation sections defined as separate arrays for Nunjucks compatibility #}
{% set learn_items = [
{'href': 'getting-started.html', 'label': 'Getting Started'},
{'href': 'core-concepts.html', 'label': 'Core Concepts'},
{'href': 'steps.html', 'label': '9-Step Scale'},
{'href': 'configuration.html', 'label': 'Configuration'}
] %}

{% set api_items = [
{'href': 'functions.html', 'label': 'Functions'},
{'href': 'mixins.html', 'label': 'Mixins'},
{'href': 'density.html', 'label': 'Density'},
{'href': '/sassdoc/', 'label': 'SassDoc'}
] %}

{% set core_items = [
{'href': 'unit.html', 'label': 'Unit'}
] %}

{% set framework_items = [
{'href': 'layers.html', 'label': 'Layers'},

{'href': 'scale.html', 'label': 'Scale'},
{'href': 'breakpoints.html', 'label': 'Breakpoints'},
{'href': 'device.html', 'label': 'Devices'},
{'href': 'paper.html', 'label': 'Formats'},
{'href': 'utilities.html', 'label': 'Utilities'},
{'href': 'ratio.html', 'label': 'Ratios'},
{'href': 'lorem.html', 'label': 'Typography'}
] %}

{% set about_items = [
{'href': 'background.html', 'label': 'Background'}
] %}

{% set nav_groups = [
{'title': 'Learn', 'items': learn_items},
{'title': 'Core', 'items': core_items},
{'title': 'Framework', 'items': framework_items},
{'title': 'API Reference', 'items': api_items},
{'title': 'About', 'items': about_items}
] %}

<aside class="docs-sidebar" id="sidebar" aria-label="Documentation navigation">
    <nav>
        {% for group in nav_groups %}
        <section class="ss-c-sidebar__section">
            <h2 class="ss-c-section-title">{{ group.title }}</h2>
            <ul class="ss-c-nav ss-c-nav--vertical">
                {% for item in group.items %}
                <li class="ss-c-nav__item">
                    <a href="{{ item.href }}" class="ss-c-nav__link" {% if current_page==item.href
                        %}aria-current="page" {% endif %}>
                        {{ item.label }}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endfor %}
    </nav>
</aside>
