<section class="ss-c-demo__section">
    <h2>Current Viewport</h2>

    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Viewport</div>
            <div class="ss-c-stat__value"><span id="bp-width">—</span>px</div>
        </div>
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Active Breakpoint</div>
            <div class="ss-c-stat__value"><span id="bp-active">—</span></div>
        </div>
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Rule</div>
            <div class="ss-c-stat__value"><span id="bp-rule">—</span></div>
        </div>
    </div>

    <p style="margin-top: calc(var(--grid-unit) * 2);">Resize the window to see which breakpoint is active. The
        active row is highlighted.</p>
</section>
