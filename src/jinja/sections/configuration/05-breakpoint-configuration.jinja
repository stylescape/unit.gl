<section>
    <h2>Breakpoint Configuration</h2>
    <p>Customize responsive breakpoints by overriding the <code>$breakpoints</code> map. Default values are derived from
        Q format paper sizes (mm × 4).</p>

    <h3>Default Breakpoints</h3>
    <div class="code-block">$breakpoints: (
        us: 240px, <span class="comment">// Q07 Portrait (60mm)</span>
        ss: 360px, <span class="comment">// Q06 Portrait (90mm)</span>
        xs: 540px, <span class="comment">// Q05 Portrait (135mm)</span>
        sm: 720px, <span class="comment">// Q04 Portrait (180mm)</span>
        md: 1440px, <span class="comment">// Q03 Landscape (360mm)</span>
        lg: 2160px, <span class="comment">// Q02 Landscape (540mm)</span>
        xl: 2880px, <span class="comment">// Q01 Landscape (720mm)</span>
        ul: 4320px, <span class="comment">// Q00 Landscape (1080mm)</span>
        ) !default;</div>

    <h3>Customizing</h3>
    <div class="code-block"><span class="comment">// Tailwind-style breakpoints</span>
        $breakpoints: (
        sm: 640px,
        md: 768px,
        lg: 1024px,
        xl: 1280px,
        2xl: 1536px,
        );

        <span class="comment">// Bootstrap-style breakpoints</span>
        $breakpoints: (
        sm: 576px,
        md: 768px,
        lg: 992px,
        xl: 1200px,
        xxl: 1400px,
        );
    </div>
</section>
