<section>
    <h2>Aspect Ratios</h2>

    <p>unit.gl includes predefined aspect ratios for images, videos, and containers:</p>

    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: calc(var(--grid-unit) * 2); margin: calc(var(--grid-unit) * 3) 0;">
        {% for ratio in ['1x1', '4x3', '3x2', '16x9', '21x9'] %}
        {% set w, h = ratio.split('x') %}
        <div>
            <div style="aspect-ratio: {{ w }}/{{ h }}; background: var(--swiss-black); margin-bottom: 8px;"></div>
            <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--swiss-gray-500);">{{ ratio
                }}</span>
        </div>
        {% endfor %}
    </div>

    <div class="code-block"><span class="comment">// Using ratio classes</span>
        &lt;div class="<span class="class">ratio_16x9</span>"&gt;
        &lt;img src="video-thumb.jpg" alt="Video"&gt;
        &lt;/div&gt;

        <span class="comment">// Using SCSS mixin</span>
        .hero-image {
        @include ratio(16, 9);
        }
    </div>
</section>
