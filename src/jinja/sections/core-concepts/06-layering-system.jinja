<section class="ss-c-demo__section">
    <h2>Layering System</h2>

    <p>unit.gl provides semantic z-index management to prevent "z-index wars":</p>

    <div
        style="display: flex; flex-direction: column-reverse; gap: 2px; margin: calc(var(--grid-unit) * 3) 0; max-width: 300px;">
        {% set layers = [['canvas', -1000, '#6b7280'], ['content', 2000, '#1d4ed8'], ['interface', 4000, '#15803d'],
        ['modal', 7000, '#b91c1c'], ['guides', 9998, '#0369a1']] %}
        {% for name, z, color in layers %}
        <div
            style="background: {{ color }}; color: white; padding: 8px 16px; display: flex; justify-content: space-between; font-size: 0.75rem;">
            <span>{{ name }}</span>
            <span style="font-family: var(--ss-font-family-mono);">z: {{ z }}</span>
        </div>
        {% endfor %}
    </div>

    <pre class="ss-c-code-block"><code><span class="comment">// Use semantic layer names</span>
        .modal {
        z-index: z("modal"); <span class="comment">// 7000</span>
        }

        .navbar {
        z-index: z("interface"); <span class="comment">// 4000</span>
        }

        .tooltip {
        z-index: z("interface") + 10; <span class="comment">// 4010</span>
        }</code></pre>
</section>
