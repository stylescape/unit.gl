<section>
    <h2>Responsive Breakpoints</h2>

    <p>unit.gl uses a mobile-first breakpoint system derived from Q format paper sizes:</p>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Min Width</th>
                <th>CSS Class Prefix</th>
                <th>Target</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>us</td>
                <td>240px</td>
                <td><code>.us_*</code></td>
                <td>Compact / Fold</td>
            </tr>
            <tr>
                <td>ss</td>
                <td>360px</td>
                <td><code>.ss_*</code></td>
                <td>Phones</td>
            </tr>
            <tr>
                <td>xs</td>
                <td>540px</td>
                <td><code>.xs_*</code></td>
                <td>Large phones</td>
            </tr>
            <tr>
                <td>sm</td>
                <td>720px</td>
                <td><code>.sm_*</code></td>
                <td>Tablets</td>
            </tr>
            <tr>
                <td>md</td>
                <td>1440px</td>
                <td><code>.md_*</code></td>
                <td>Laptops</td>
            </tr>
            <tr>
                <td>lg</td>
                <td>2160px</td>
                <td><code>.lg_*</code></td>
                <td>QHD desktops</td>
            </tr>
            <tr>
                <td>xl</td>
                <td>2880px</td>
                <td><code>.xl_*</code></td>
                <td>4K displays</td>
            </tr>
            <tr>
                <td>ul</td>
                <td>4320px</td>
                <td><code>.ul_*</code></td>
                <td>5K+ displays</td>
            </tr>
        </tbody>
    </table>

    <div class="code-block"><pre><code><span class="comment">// Using breakpoint mixins</span>
        .card {
        padding: q(16);

        @include media_md {
        padding: q(24);
        }

        @include media_lg {
        padding: q(32);
        }
        }</code></pre></div>
</section>
