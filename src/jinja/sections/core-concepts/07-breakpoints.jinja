<section>
    <h2>Responsive Breakpoints</h2>

    <p>unit.gl uses a mobile-first 9-step breakpoint scale derived from Q format paper sizes:</p>

    <table class="table">
        <thead>
            <tr>
                <th>Key</th>
                <th>Full Name</th>
                <th>Step</th>
                <th>Min Width</th>
                <th>CSS Class Prefix</th>
                <th>Target</th>
            </tr>
        </thead>
        <tbody>
            <tr><td><code>us</code></td><td>Ultra Small</td><td>1</td><td>240px</td><td><code>.us_*</code></td><td>Compact / Fold</td></tr>
            <tr><td><code>ss</code></td><td>Super Small</td><td>2</td><td>360px</td><td><code>.ss_*</code></td><td>Phones</td></tr>
            <tr><td><code>xs</code></td><td>Extra Small</td><td>3</td><td>540px</td><td><code>.xs_*</code></td><td>Large phones</td></tr>
            <tr><td><code>sm</code></td><td>Small</td><td>4</td><td>720px</td><td><code>.sm_*</code></td><td>Tablets</td></tr>
            <tr><td><code>md</code></td><td>Medium</td><td>5</td><td>1080px</td><td><code>.md_*</code></td><td>Laptops</td></tr>
            <tr><td><code>lg</code></td><td>Large</td><td>6</td><td>1440px</td><td><code>.lg_*</code></td><td>Desktops</td></tr>
            <tr><td><code>xl</code></td><td>Extra Large</td><td>7</td><td>2160px</td><td><code>.xl_*</code></td><td>QHD desktops</td></tr>
            <tr><td><code>sl</code></td><td>Super Large</td><td>8</td><td>2880px</td><td><code>.sl_*</code></td><td>4K displays</td></tr>
            <tr><td><code>ul</code></td><td>Ultra Large</td><td>9</td><td>4320px</td><td><code>.ul_*</code></td><td>5K+ displays</td></tr>
        </tbody>
    </table>

    <div class="code-block"><pre><code><span class="comment">// Using breakpoint mixins</span>
        .card {
        padding: q(16);

        @include media_md {
        padding: q(24);
        }

        @include media_lg {
        padding: q(32);
        }
        }</code></pre></div>
</section>
