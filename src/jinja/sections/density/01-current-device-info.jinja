<section class="ss-c-demo__section">
    <h2>Your Display</h2>
    <p>Real-time information about your current display's pixel density.</p>

    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-card ss-c-stat">
            <span class="ss-c-stat__title">Device Pixel Ratio</span>
            <span class="ss-c-stat__value" id="current-dpr">—</span>
        </div>
        <div class="ss-c-card ss-c-stat">
            <span class="ss-c-stat__title">Density Bucket</span>
            <span class="ss-c-stat__value" id="current-bucket">—</span>
        </div>
        <div class="ss-c-card ss-c-stat">
            <span class="ss-c-stat__title">CSS resolution (96 × DPR)</span>
            <span class="ss-c-stat__value" id="current-dpi">—</span>
        </div>
        <div class="ss-c-card ss-c-stat">
            <span class="ss-c-stat__title">CSS Variable</span>
            <span class="ss-c-stat__value"><code>var(--dpr)</code></span>
        </div>
    </div>
</section>
