<section>
    <h2>Your Display</h2>
    <p>Real-time information about your current display's pixel density.</p>

    <div class="density-current">
        <div class="density-current__item">
            <span class="density-current__label">Device Pixel Ratio</span>
            <span class="density-current__value" id="current-dpr">—</span>
        </div>
        <div class="density-current__item">
            <span class="density-current__label">Density Bucket</span>
            <span class="density-current__value" id="current-bucket">—</span>
        </div>
        <div class="density-current__item">
            <span class="density-current__label">Effective DPI</span>
            <span class="density-current__value" id="current-dpi">—</span>
        </div>
        <div class="density-current__item">
            <span class="density-current__label">CSS Variable</span>
            <span class="density-current__value"><code>var(--dpr)</code></span>
        </div>
    </div>
</section>
