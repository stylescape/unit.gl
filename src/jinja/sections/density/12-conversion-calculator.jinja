<section class="ss-c-demo__section">
    <h2>Conversion Calculator</h2>

    <div class="ss-c-card ss-c-demo__stack">
        <div class="ss-c-form-field">
            <label class="ss-c-label" for="calc-q">Q Units</label>
            <input type="number" class="ss-c-input" id="calc-q" value="16" min="0">
        </div>

        <div class="ss-l-grid ss-l-grid-auto">
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">Millimeters</span>
                <span class="ss-c-stat__value" id="calc-mm">4mm</span>
            </div>
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">Inches</span>
                <span class="ss-c-stat__value" id="calc-in">0.157in</span>
            </div>
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">Points</span>
                <span class="ss-c-stat__value" id="calc-pt">11.34pt</span>
            </div>
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">CSS (rem)</span>
                <span class="ss-c-stat__value" id="calc-rem">1rem</span>
            </div>
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">Physical px (1×)</span>
                <span class="ss-c-stat__value" id="calc-px1">16px</span>
            </div>
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">Physical px (2×)</span>
                <span class="ss-c-stat__value" id="calc-px2">32px</span>
            </div>
            <div class="ss-c-card ss-c-stat">
                <span class="ss-c-stat__title">Physical px (3×)</span>
                <span class="ss-c-stat__value" id="calc-px3">48px</span>
            </div>
        </div>
    </div>
</section>
