<section>
    <h2>Conversion Calculator</h2>

    <div class="density-calculator">
        <div class="density-calc__input">
            <label for="calc-q">Q Units</label>
            <input type="number" id="calc-q" value="16" min="0">
        </div>

        <div class="density-calc__results">
            <div class="density-calc__result">
                <span class="density-calc__label">Millimeters</span>
                <span class="density-calc__value" id="calc-mm">4mm</span>
            </div>
            <div class="density-calc__result">
                <span class="density-calc__label">Inches</span>
                <span class="density-calc__value" id="calc-in">0.157in</span>
            </div>
            <div class="density-calc__result">
                <span class="density-calc__label">Points</span>
                <span class="density-calc__value" id="calc-pt">11.34pt</span>
            </div>
            <div class="density-calc__result">
                <span class="density-calc__label">CSS (rem)</span>
                <span class="density-calc__value" id="calc-rem">1rem</span>
            </div>
            <div class="density-calc__result">
                <span class="density-calc__label">Physical px (1×)</span>
                <span class="density-calc__value" id="calc-px1">16px</span>
            </div>
            <div class="density-calc__result">
                <span class="density-calc__label">Physical px (2×)</span>
                <span class="density-calc__value" id="calc-px2">32px</span>
            </div>
            <div class="density-calc__result">
                <span class="density-calc__label">Physical px (3×)</span>
                <span class="density-calc__value" id="calc-px3">48px</span>
            </div>
        </div>
    </div>
</section>
