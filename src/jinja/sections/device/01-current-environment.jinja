<section class="ss-c-demo__section">
    <h2>Current Environment</h2>

    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Viewport</div>
            <div class="ss-c-stat__value"><span id="dev-width">—</span>×<span id="dev-height">—</span>px</div>
        </div>
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Device Pixel Ratio</div>
            <div class="ss-c-stat__value"><span id="dev-dpr">—</span></div>
        </div>
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Orientation</div>
            <div class="ss-c-stat__value"><span id="dev-orientation">—</span></div>
        </div>
        <div class="ss-c-card ss-c-stat">
            <div class="ss-c-stat__title">Touch Points</div>
            <div class="ss-c-stat__value"><span id="dev-touch">—</span></div>
        </div>
    </div>
</section>
