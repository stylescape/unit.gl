<section class="ss-c-demo__section">
    <h2>SCSS Usage</h2>

    <pre class="ss-c-code-block"><code>@use "unit.gl" as *;

// Target a specific device profile from $devices
@include device_media_query("galaxy_fold") {
  .panel { padding: q(10); }
}
</code></pre>

    <p class="ss-c-text-muted">Profile keys are underscored (for example <code>iphone_x</code>, <code>ipad_pro</code>,
        <code>macbook_pro</code>).
    </p>
</section>
