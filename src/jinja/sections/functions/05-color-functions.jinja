<section class="ss-c-demo__section">
    <h2>Color Functions</h2>
    <p>Functions for working with the color map.</p>

    <h3>color()</h3>
    <pre class="ss-c-code-block">color($name, $shade: null) → Color</pre>

    <table class="ss-c-table">
        <tbody>
            <tr>
                <td><code>$name</code></td>
                <td><span class="ss-c-badge ss-c-badge--sm">String</span></td>
                <td>Color name from $color_map</td>
            </tr>
            <tr>
                <td><code>$shade</code></td>
                <td><span class="ss-c-badge ss-c-badge--sm">String | null</span></td>
                <td>Optional shade variant (e.g., 'light', 'dark')</td>
            </tr>
        </tbody>
    </table>

    <pre class="ss-c-code-block"><code>.button {
        background: color("primary");
        color: color("primary", "contrast");

        &:hover {
        background: color("primary", "dark");
        }
        }</code></pre>
</section>
