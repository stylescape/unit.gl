<section>
    <h2>Vertical Rhythm</h2>
    <p>Spacing values that maintain baseline alignment.</p>

    <div class="rhythm-example">
        <div class="rhythm-block">
            <h4>Heading Level 2</h4>
            <p>Subheading or description text on the rhythm grid.</p>
            <div class="rhythm-spec">
                <span class="rhythm-spec__item">font-size: 24px</span>
                <span class="rhythm-spec__item">line-height: 32px</span>
                <span class="rhythm-spec__item">margin-bottom: 16px</span>
            </div>
        </div>

        <div class="rhythm-block">
            <h4>Body Text</h4>
            <p>Standard paragraph text with comfortable reading line height.</p>
            <div class="rhythm-spec">
                <span class="rhythm-spec__item">font-size: 16px</span>
                <span class="rhythm-spec__item">line-height: 24px</span>
                <span class="rhythm-spec__item">margin-bottom: 24px</span>
            </div>
        </div>

        <div class="rhythm-block">
            <h4>Caption Text</h4>
            <p>Smaller text for captions, labels, and meta information.</p>
            <div class="rhythm-spec">
                <span class="rhythm-spec__item">font-size: 12px</span>
                <span class="rhythm-spec__item">line-height: 16px</span>
                <span class="rhythm-spec__item">margin-bottom: 8px</span>
            </div>
        </div>
    </div>
</section>
