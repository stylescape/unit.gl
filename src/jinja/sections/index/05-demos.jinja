<section class="ss-c-demo__section">
    <h2>Live Demos</h2>

    {% set demos = [
    {"name": "breakpoints", "title": "Breakpoints", "tag": "responsive", "desc": "Interactive view of $breakpoints (includes ss)"},
    {"name": "device", "title": "Device Explorer", "tag": "media", "desc": "Detect media features + match $devices profiles"},
    {"name": "paper", "title": "Page Formats", "tag": "print", "desc": "Explore Q-series formats (res/) and format() usage"},
    {"name": "unit", "title": "Q Unit Explorer", "tag": "units", "desc": "Interactively explore q() and the $q_steps ladder"},
    {"name": "utilities", "title": "Utility Classes", "tag": "interactive", "desc": "Explore spacing, sizing, and responsive utilities"},
    {"name": "scale", "title": "Typographic Scale", "tag": "typography", "desc": "See modular scale ratios in action"},
    {"name": "ratio", "title": "Aspect Ratios", "tag": "layout", "desc": "Visual demonstration of all ratio presets"},
    {"name": "layers", "title": "Layer System", "tag": "z-index", "desc": "Interactive stacking context visualization"},
    {"name": "guide-baseline", "title": "Baseline Grid", "tag": "guides", "desc": "Toggle alignment guides and grids"}
    ] %}

    <div class="ss-l-grid ss-l-grid-auto">
        {% for page in demos %}
        <a href="{{ page.name }}.html" class="ss-c-card ss-c-card--interactive">
            <span class="ss-c-badge ss-c-badge--sm{% if page.tag == 'interactive' %} ss-c-badge--accent{% endif %}">{{ page.tag }}</span>
            <h3 class="ss-c-card__title">{{ page.title }} →</h3>
            <p class="ss-c-card__description">{{ page.desc }}</p>
        </a>
        {% endfor %}
    </div>
</section>
