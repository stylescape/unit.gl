{# Interactive Demo #}
<section class="ss-c-demo__section">
    <h2>Interactive Demo</h2>
    <p>Click the buttons to toggle layers and visualize the stacking order. Layers higher in the stack appear in
        front
        of lower layers.</p>

    <div class="ss-c-demo__group">
        {% set layers = [
        {"name": "guides", "z": "9998"},
        {"name": "modal", "z": "7000"},
        {"name": "interface", "z": "4000"},
        {"name": "content", "z": "2000"},
        {"name": "canvas", "z": "-1000"}
        ] %}
        {% for layer in layers %}
        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--solid" id="btn-{{ layer.name }}"
            data-layer="{{ layer.name }}" aria-pressed="true">{{ layer.name }}</button>
        {% endfor %}
        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-layers="show">Show All</button>
        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-layers="hide">Hide All</button>
    </div>

    <div class="layer-demo">
        {% for layer in layers %}
        <div class="layer-box z-{{ layer.name }}" id="layer-{{ layer.name }}">
            <span class="layer-box__name">{{ layer.name }}</span>
            <span class="layer-box__value">z("{{ layer.name }}")</span>
            <span class="layer-box__zindex">z-index: {{ layer.z }}</span>
        </div>
        {% endfor %}
    </div>
</section>
