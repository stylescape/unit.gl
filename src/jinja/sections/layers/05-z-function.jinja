{# The z() Function #}
<section class="ss-c-demo__section">
    <h2>The z() Function</h2>

    <pre class="ss-c-code-block">z($layer)</pre>

    <p>Returns the z-index value for the specified layer name.</p>

    <h3>Parameters</h3>

    <table class="ss-c-table">
        <tbody>
            <tr>
                <td><code>$layer</code></td>
                <td><span class="ss-c-badge ss-c-badge--sm">String</span></td>
                <td>The name of the layer (e.g., "modal", "interface", "content")</td>
            </tr>
        </tbody>
    </table>

    <h3>Returns</h3>
    <p><code>Number</code> — The z-index value associated with the layer, or <code>null</code> if not found.</p>

    <h3>Example</h3>

    <pre class="ss-c-code-block"><code>@use "unit.gl" as *;

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: z("modal"); // 7000
}

.sticky-header {
  position: sticky;
  top: 0;
  z-index: z("interface"); // 4000
}

.card {
  position: relative;
  z-index: z("content"); // 2000
}

.background-pattern {
  position: absolute;
  z-index: z("canvas"); // -1000
}</code></pre>
</section>
