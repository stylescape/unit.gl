<section class="ss-c-demo__section">
    <h2>Responsive Breakpoints</h2>
    <p>Mobile-first breakpoint mixins built on the <code>$breakpoints</code> map.</p>

    <h3>breakpoint()</h3>
    <p>Apply styles at a named breakpoint and above.</p>

    <pre class="ss-c-code-block">@include breakpoint($size) { ... }</pre>

    <table class="ss-c-table">
        <tbody>
            <tr>
                <td><code>$size</code></td>
                <td><span class="ss-c-badge ss-c-badge--sm">String</span></td>
                <td>Breakpoint key from <code>$breakpoints</code></td>
            </tr>
        </tbody>
    </table>

    <h4>Available Breakpoints</h4>
    <table class="ss-c-table">
        <thead>
            <tr>
                <th>Key</th>
                <th>Full Name</th>
                <th>Step</th>
                <th>Min Width</th>
                <th>Q Format</th>
                <th>Typical Devices</th>
            </tr>
        </thead>
        <tbody>
            <tr><td><code>us</code></td><td>Ultra Small</td><td>1</td><td>250px</td><td>Q07 Portrait (62.5mm)</td><td>Compact / fold devices</td></tr>
            <tr><td><code>ss</code></td><td>Super Small</td><td>2</td><td>360px</td><td>Q06 Portrait (90mm)</td><td>Phones</td></tr>
            <tr><td><code>xs</code></td><td>Extra Small</td><td>3</td><td>540px</td><td>Q05 Portrait (135mm)</td><td>Large phones</td></tr>
            <tr><td><code>sm</code></td><td>Small</td><td>4</td><td>720px</td><td>Q04 Portrait (180mm)</td><td>Tablets</td></tr>
            <tr><td><code>md</code></td><td>Medium</td><td>5</td><td>1080px</td><td>Q04 Landscape (270mm)</td><td>Laptops</td></tr>
            <tr><td><code>lg</code></td><td>Large</td><td>6</td><td>1440px</td><td>Q03 Landscape (360mm)</td><td>Desktops</td></tr>
            <tr><td><code>xl</code></td><td>Extra Large</td><td>7</td><td>2160px</td><td>Q02 Landscape (540mm)</td><td>QHD desktops</td></tr>
            <tr><td><code>sl</code></td><td>Super Large</td><td>8</td><td>2880px</td><td>Q01 Landscape (720mm)</td><td>4K displays</td></tr>
            <tr><td><code>ul</code></td><td>Ultra Large</td><td>9</td><td>4320px</td><td>Q00 Landscape (1080mm)</td><td>5K+ displays</td></tr>
        </tbody>
    </table>

    <h4>Examples</h4>
    <pre class="ss-c-code-block"><code>.container {
    padding: q(16);

    @include breakpoint(md) {
        padding: q(24);
    }

    @include breakpoint(lg) {
        padding: q(32);
        max-width: 1200px;
        margin: 0 auto;
    }
}

.grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: q(16);

    @include breakpoint(sm) {
        grid-template-columns: repeat(2, 1fr);
    }

    @include breakpoint(lg) {
        grid-template-columns: repeat(4, 1fr);
        gap: q(24);
    }
}</code></pre>

    <h3>media_us, media_ss, media_xs, media_sm, media_md, media_lg, media_xl, media_sl, media_ul</h3>
    <p>Per-breakpoint shortcut mixins for each step in the 9-step scale. Equivalent to <code>@include breakpoint($name)</code> but more concise.</p>

    <pre class="ss-c-code-block"><code>.sidebar {
    display: none;

    @include media_md {
        display: block;
    }
}</code></pre>
</section>
