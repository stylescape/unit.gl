<section>
    <h2>Aspect Ratio Mixins</h2>
    <p>Apply aspect ratios to containers using the modern <code>aspect-ratio</code> property.</p>

    <h3>aspect_ratio()</h3>
    <p>Sets a custom aspect ratio on an element.</p>

    <div class="api-signature">@include aspect_ratio($width, $height)</div>

    <div class="api-params">
        <div class="api-param">
            <span class="api-param__name">$width</span>
            <span class="api-param__type">Number</span>
            <span class="api-param__desc">Width portion of the ratio</span>
        </div>
        <div class="api-param">
            <span class="api-param__name">$height</span>
            <span class="api-param__type">Number</span>
            <span class="api-param__desc">Height portion of the ratio</span>
        </div>
    </div>

    <div class="code-block"><pre><code>.video-container {
    @include aspect_ratio(16, 9);
}

.square {
    @include aspect_ratio(1, 1);
}

.photo {
    @include aspect_ratio(4, 3);
}</code></pre></div>

    <h3>aspect_ratio--{ratio}</h3>
    <p>Predefined aspect-ratio mixins for common ratios. Each is a standalone mixin (no arguments).</p>

    <h4>Available Mixins</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Mixin</th>
                <th>Ratio</th>
                <th>Use Case</th>
            </tr>
        </thead>
        <tbody>
            <tr><td><code>aspect_ratio--1x1</code></td><td>1:1</td><td>Avatars, icons</td></tr>
            <tr><td><code>aspect_ratio--4x3</code></td><td>4:3</td><td>Traditional photography</td></tr>
            <tr><td><code>aspect_ratio--3x2</code></td><td>3:2</td><td>35mm film</td></tr>
            <tr><td><code>aspect_ratio--16x9</code></td><td>16:9</td><td>Video, presentations</td></tr>
            <tr><td><code>aspect_ratio--16x10</code></td><td>16:10</td><td>Widescreen monitors</td></tr>
            <tr><td><code>aspect_ratio--2x1</code></td><td>2:1</td><td>Banners</td></tr>
            <tr><td><code>aspect_ratio--3x1</code></td><td>3:1</td><td>Wide banners</td></tr>
            <tr><td><code>aspect_ratio--4x1</code></td><td>4:1</td><td>Ultra-wide</td></tr>
            <tr><td><code>aspect_ratio--2x3</code></td><td>2:3</td><td>Portrait photos</td></tr>
            <tr><td><code>aspect_ratio--3x4</code></td><td>3:4</td><td>Portrait</td></tr>
            <tr><td><code>aspect_ratio--9x16</code></td><td>9:16</td><td>Vertical video</td></tr>
            <tr><td><code>aspect_ratio--10x16</code></td><td>10:16</td><td>Vertical widescreen</td></tr>
            <tr><td><code>aspect_ratio--1x2</code></td><td>1:2</td><td>Tall banners</td></tr>
            <tr><td><code>aspect_ratio--1x3</code></td><td>1:3</td><td>Tall sidebar</td></tr>
            <tr><td><code>aspect_ratio--1x4</code></td><td>1:4</td><td>Vertical strip</td></tr>
        </tbody>
    </table>

    <div class="code-block"><pre><code>.card-image {
    @include aspect_ratio--4x3;
}

.video-embed {
    @include aspect_ratio--16x9;
}

.story {
    @include aspect_ratio--9x16;
}</code></pre></div>
</section>
