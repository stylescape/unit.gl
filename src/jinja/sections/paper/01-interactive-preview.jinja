<section class="ss-c-demo__section">
        <h2>Interactive Preview</h2>
        <p class="ss-c-text-muted">Compare formats at true relative scale. All sizes shown proportionally to each other.</p>

        <div class="ss-c-card">
            <div class="ss-c-demo__group">
                <label class="ss-c-form-field">
                    <span class="ss-c-label">Format</span>
                    <select id="paper-format" class="ss-c-select" aria-label="Page format">
                        <optgroup label="Q-Series">
                            {% for f in q_formats %}
                            <option value="{{ f.key }}" data-w="{{ f.w }}" data-h="{{ f.h }}">{{ f.key }}</option>
                            {% endfor %}
                        </optgroup>
                        <optgroup label="ISO A-Series">
                            {% for f in iso_formats %}
                            <option value="{{ f.key }}" data-w="{{ f.w }}" data-h="{{ f.h }}">{{ f.key | upper }}</option>
                            {% endfor %}
                        </optgroup>
                        <optgroup label="US Formats">
                            {% for f in us_formats %}
                            <option value="{{ f.key }}" data-w="{{ f.w }}" data-h="{{ f.h }}">{{ f.key | capitalize }}
                            </option>
                            {% endfor %}
                        </optgroup>
                    </select>
                </label>

                <div class="ss-c-demo__group" role="group" aria-label="Orientation">
                    <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--solid" data-orient="portrait" aria-pressed="true">Portrait</button>
                    <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-orient="landscape" aria-pressed="false">Landscape</button>
                </div>
            </div>
        </div>

        <div class="paper-preview-wrap">
            <div class="paper-preview-container" id="paper-preview-container">
                <div class="paper-preview" id="paper-preview" aria-label="Page preview">
                    <div class="paper-preview__meta">
                        <div class="paper-preview__title" id="paper-title">q04</div>
                        <div class="paper-preview__dims"><span id="paper-w">—</span> × <span id="paper-h">—</span> mm
                        </div>
                    </div>
                </div>
            </div>
            <div class="ss-t-label">
                <span id="scale-display">Scale: 1:1</span>
            </div>
        </div>

        <pre class="ss-c-code-block"><code>// SCSS
.print-sheet {
  @include format(<span id="paper-code">q04</span>, <span id="paper-code-or">portrait</span>);
}</code></pre>
    </section>
