<section class="ss-c-demo__section">
        <h2>Q-Series Reference</h2>
        <p class="ss-c-text-muted">Complete Q-series formats from <code>res/paper_size_metric_q.csv</code>.</p>

        <table class="ss-c-table">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Width (mm)</th>
                    <th>Height (mm)</th>
                    <th>Area (cm²)</th>
                    <th>~Equivalent</th>
                </tr>
            </thead>
            <tbody>
                {% for f in q_formats %}
                <tr>
                    <td><code>{{ f.key }}</code></td>
                    <td><code>{{ f.w }}</code></td>
                    <td><code>{{ f.h }}</code></td>
                    <td>{{ ((f.w * f.h) / 100) | round(1) }}</td>
                    <td>
                        {% if f.key == 'q04' %}≈ A5
                        {% elif f.key == 'q03' %}≈ A4
                        {% elif f.key == 'q02' %}≈ A3
                        {% elif f.key == 'q05' %}≈ A6
                        {% elif f.key == 'q01' %}≈ A2
                        {% elif f.key == 'q00' %}≈ A1
                        {% else %}—
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
