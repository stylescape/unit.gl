<section>
    <h2>Common Ratios</h2>
    <p>Standard aspect ratios used in film, photography, print, and digital media.</p>

    <div class="ratio-grid">
        {% set ratios = [
        ('1:1', 'Square', 1, 1),
        ('4:3', 'Classic', 4, 3),
        ('3:2', 'Photo', 3, 2),
        ('16:9', 'Widescreen', 16, 9),
        ('21:9', 'Ultrawide', 21, 9),
        ('9:16', 'Portrait', 9, 16)
        ] %}
        {% for name, desc, w, h in ratios %}
        {{ ratio_card(name, desc, w, h) }}
        {% endfor %}
    </div>
</section>
