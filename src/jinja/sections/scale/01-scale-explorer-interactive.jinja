<section class="ss-c-demo__section">
            <h2>Scale Explorer</h2>
            <p>
                Explore the relationship between Type Scale (4Q) and Line Scale (5Q)
                interactively. The LCM of 20Q ensures both scales align at regular intervals.
            </p>

            <div class="ss-c-card ss-c-demo__stack">
                <div class="ss-c-demo__stack">
                    <div class="ss-c-demo__group">
                        <label class="ss-c-label" for="scaleSlider">Scale Value</label>
                        <input type="range" class="ss-c-range" id="scaleSlider" min="1" max="24" value="4" step="1">
                        <span class="ss-c-badge" id="sliderValue">4</span>
                    </div>

                    <div class="ss-c-demo__group">
                        <span class="ss-c-label">Quick Select:</span>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="1" aria-pressed="false">1</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="2" aria-pressed="false">2</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="3" aria-pressed="false">3</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--solid" data-value="4" aria-pressed="true">4</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="5" aria-pressed="false">5</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="6" aria-pressed="false">6</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="8" aria-pressed="false">8</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="10" aria-pressed="false">10</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="12" aria-pressed="false">12</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="16" aria-pressed="false">16</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline" data-value="20" aria-pressed="false">20</button>
                    </div>
                </div>

                <div class="ss-c-demo__stack">
                    <div class="ss-l-grid ss-l-grid-auto">
                        <div class="ss-c-card ss-c-stat">
                            <h3 class="ss-c-stat__title">Type Scale</h3>
                            <div class="ss-c-stat__value" id="typeQ">16Q</div>
                            <div class="ss-c-stat__desc">
                                <span id="typePx">16px</span>
                                <span id="typeMm">4mm</span>
                                <span id="typeRem">1rem</span>
                            </div>
                        </div>

                        <div class="ss-c-card ss-c-stat">
                            <h3 class="ss-c-stat__title">Line Scale</h3>
                            <div class="ss-c-stat__value" id="lineQ">20Q</div>
                            <div class="ss-c-stat__desc">
                                <span id="linePx">20px</span>
                                <span id="lineMm">5mm</span>
                                <span id="lineRem">1.25rem</span>
                            </div>
                        </div>

                        <div class="ss-c-card ss-c-stat">
                            <h3 class="ss-c-stat__title">LCM Alignment</h3>
                            <div class="ss-c-stat__value" id="lcmValue">20Q</div>
                            <div class="ss-c-stat__desc">
                                <span id="lcmMultiple">1× LCM</span>
                                <span id="lcmAligned" class="ss-c-text-success">✓ Aligned</span>
                            </div>
                        </div>
                    </div>

                    <div class="explorer-preview">
                        <div class="preview-box" id="previewBox">
                            <span class="preview-label">Visual Size</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
