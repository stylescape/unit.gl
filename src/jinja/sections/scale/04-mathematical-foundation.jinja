<section class="ss-c-demo__section">
            <h2>Mathematical Foundation</h2>

            <div class="ss-l-grid ss-l-grid-auto">
                <div class="ss-c-card">
                    <h3>LCM (Least Common Multiple)</h3>
                    <div class="ss-c-code-block">
                        <code>LCM(4, 5) = 20</code>
                    </div>
                    <p>
                        The Type Scale (4Q) and Line Scale (5Q) share a least common multiple
                        of 20Q. This ensures both scales align perfectly every 20 pixels,
                        creating natural harmony between typography and vertical rhythm.
                    </p>
                    <div class="ss-c-demo__stack">
                        <span>Type: 4, 8, 12, 16, <strong>20</strong>, 24, 28, 32, 36, <strong>40</strong>...</span>
                        <span>Line: 5, 10, 15, <strong>20</strong>, 25, 30, 35, <strong>40</strong>...</span>
                    </div>
                </div>

                <div class="ss-c-card">
                    <h3>HCN (Highly Composite Numbers)</h3>
                    <div class="ss-c-code-block">
                        <code>12, 24, 36, 48, 60, 120, 180, 240, 360, 720...</code>
                    </div>
                    <p>
                        Highly Composite Numbers have more divisors than any smaller positive
                        integer. The Q format system leverages HCN for maximum flexibility—dimensions
                        like 720, 1080, and 1440 are divisible by many factors, enabling clean
                        subdivisions for grids, columns, and modular layouts.
                    </p>
                    <div class="ss-l-grid ss-l-grid-auto">
                        <div class="ss-c-card ss-c-stat">
                            <span class="ss-c-stat__value">12</span>
                            <span class="ss-c-stat__desc">1,2,3,4,6,12</span>
                            <span class="ss-c-stat__title">6 divisors</span>
                        </div>
                        <div class="ss-c-card ss-c-stat">
                            <span class="ss-c-stat__value">24</span>
                            <span class="ss-c-stat__desc">1,2,3,4,6,8,12,24</span>
                            <span class="ss-c-stat__title">8 divisors</span>
                        </div>
                        <div class="ss-c-card ss-c-stat">
                            <span class="ss-c-stat__value">60</span>
                            <span class="ss-c-stat__desc">1,2,3,4,5,6,10,12,15,20,30,60</span>
                            <span class="ss-c-stat__title">12 divisors</span>
                        </div>
                        <div class="ss-c-card ss-c-stat">
                            <span class="ss-c-stat__value">120</span>
                            <span class="ss-c-stat__desc">1,2,3,4,5,6,8,10,12,15,20,24,30,40,60,120</span>
                            <span class="ss-c-stat__title">16 divisors</span>
                        </div>
                        <div class="ss-c-card ss-c-stat ss-c-card--accent">
                            <span class="ss-c-stat__value">720</span>
                            <span class="ss-c-stat__desc">Q04 Width: 720px ÷ 5 = 144 lines</span>
                            <span class="ss-c-stat__title">30 divisors</span>
                        </div>
                        <div class="ss-c-card ss-c-stat ss-c-card--accent">
                            <span class="ss-c-stat__value">1080</span>
                            <span class="ss-c-stat__desc">Q04 Height: 1080px ÷ 5 = 216 lines</span>
                            <span class="ss-c-stat__title">18 divisors</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
