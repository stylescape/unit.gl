<!-- Unit Conversion -->
<section>
    <h2>Unit Conversion</h2>

    <p>Understanding how Q units convert to other measurements helps with design decisions:</p>

    <table class="table">
        <thead>
            <tr>
                <th>Q Value</th>
                <th>REM</th>
                <th>PX (16px base)</th>
                <th>MM</th>
                <th>Common Use</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>q(1)</code></td>
                <td>0.0625rem</td>
                <td>1px</td>
                <td>0.25mm</td>
                <td>Borders, very fine details</td>
            </tr>
            <tr>
                <td><code>q(4)</code></td>
                <td>0.25rem</td>
                <td>4px</td>
                <td>1mm</td>
                <td>Small gaps, micro spacing</td>
            </tr>
            <tr>
                <td><code>q(8)</code></td>
                <td>0.5rem</td>
                <td>8px</td>
                <td>2mm</td>
                <td>Base spacing unit</td>
            </tr>
            <tr>
                <td><code>q(16)</code></td>
                <td>1rem</td>
                <td>16px</td>
                <td>4mm</td>
                <td>Standard spacing (1rem)</td>
            </tr>
            <tr>
                <td><code>q(24)</code></td>
                <td>1.5rem</td>
                <td>24px</td>
                <td>6mm</td>
                <td>Medium spacing</td>
            </tr>
            <tr>
                <td><code>q(32)</code></td>
                <td>2rem</td>
                <td>32px</td>
                <td>8mm</td>
                <td>Large spacing</td>
            </tr>
            <tr>
                <td><code>q(64)</code></td>
                <td>4rem</td>
                <td>64px</td>
                <td>16mm</td>
                <td>Section spacing</td>
            </tr>
            <tr>
                <td><code>q(128)</code></td>
                <td>8rem</td>
                <td>128px</td>
                <td>32mm</td>
                <td>Major sections</td>
            </tr>
        </tbody>
    </table>
</section>
