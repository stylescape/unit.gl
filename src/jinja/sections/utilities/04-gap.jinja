{# Gap #}
<section class="ss-c-demo__section">
    <h2>Gap</h2>
    <p>Control flex/grid gaps: <code>.gap_q*</code>, <code>.gap_col_q*</code>, <code>.gap_row_q*</code></p>

    <div class="ss-c-demo__group">
        {% for step in [4, 8, 16, 24, 32] %}
        <div class="ss-c-demo__stack">
            <div class="gap-demo gap_q{{ step }}">
                <div class="gap-item"></div>
                <div class="gap-item"></div>
                <div class="gap-item"></div>
            </div>
            <span class="ss-t-label">.gap_q{{ step }}</span>
        </div>
        {% endfor %}
    </div>

    <pre class="ss-c-code-block"><code>&lt;div class="<span class="class">gap_q8</span>" style="display: flex;"&gt;...&lt;/div&gt;
        &lt;div class="<span class="class">gap_col_q16 gap_row_q8</span>" style="display: grid;"&gt;...&lt;/div&gt;</code></pre>
</section>
