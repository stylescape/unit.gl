{# Width & Height #}
<section class="ss-c-demo__section">
    <h2>Width & Height</h2>
    <p>Control dimensions: <code>.w_q*</code>, <code>.h_q*</code>, <code>.min_w_q*</code>, <code>.max_w_q*</code>,
        <code>.min_h_q*</code>, <code>.max_h_q*</code>
    </p>

    <h3>Width</h3>
    <div class="ss-c-demo__group">
        {% for step in [32, 48, 64, 96, 128] %}
        <div class="ss-c-demo__stack">
            <div class="size-box w_q{{ step }} h_q24"></div>
            <span class="ss-t-label">.w_q{{ step }}</span>
        </div>
        {% endfor %}
    </div>

    <h3>Height</h3>
    <div class="ss-c-demo__group">
        {% for step in [24, 32, 48, 64, 96] %}
        <div class="ss-c-demo__stack">
            <div class="size-box w_q24 h_q{{ step }}"></div>
            <span class="ss-t-label">.h_q{{ step }}</span>
        </div>
        {% endfor %}
    </div>

    <pre class="ss-c-code-block"><code>&lt;div class="<span class="class">w_q64 h_q48</span>"&gt;64×48 pixels&lt;/div&gt;
        &lt;div class="<span class="class">min_w_q128 max_w_q256</span>"&gt;Min 128px, Max 256px&lt;/div&gt;</code></pre>
</section>
