{# Border Radius #}
<section class="ss-c-demo__section">
    <h2>Border Radius</h2>
    <p>Control border radius: <code>.rounded_q*</code>, <code>.rounded_t_q*</code>, <code>.rounded_r_q*</code>,
        <code>.rounded_b_q*</code>, <code>.rounded_l_q*</code>
    </p>

    <div class="ss-c-demo__group">
        {% for step in [0, 4, 8, 12, 16, 24, 32] %}
        <div class="ss-c-demo__stack">
            <div class="radius-demo rounded_q{{ step }}"></div>
            <span class="ss-t-label">.rounded_q{{ step }}</span>
        </div>
        {% endfor %}
    </div>

    <pre class="ss-c-code-block"><code>&lt;div class="<span class="class">rounded_q8</span>"&gt;8px radius&lt;/div&gt;
        &lt;div class="<span class="class">rounded_t_q16</span>"&gt;16px top corners only&lt;/div&gt;</code></pre>
</section>
