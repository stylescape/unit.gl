{% extends "base.html.jinja" %}

{%- block title %}Layering System — unit.gl{%- endblock %}

{%- block header %}
<p class="eyebrow">Documentation</p>
<h1>Layering System</h1>
<p class="lead">Semantic z-index management with the <code>z()</code> function. Build predictable stacking contexts.</p>
{%- endblock %}

{%- block content %}

<div class="page--layers">

  <!-- Interactive Demo -->
  <section>
    <h2>Interactive Demo</h2>
    <p>Click the buttons to toggle layers and visualize the stacking order. Layers higher in the stack appear in front
      of lower layers.</p>

    <div class="layer-controls">
      {% set layers = [
      {"name": "guides", "z": "9998"},
      {"name": "modal", "z": "7000"},
      {"name": "interface", "z": "4000"},
      {"name": "content", "z": "2000"},
      {"name": "canvas", "z": "-1000"}
      ] %}
      {% for layer in layers %}
      <button class="layer-btn layer-btn--active" id="btn-{{ layer.name }}" onclick="toggleLayer('{{ layer.name }}')">{{
        layer.name }}</button>
      {% endfor %}
      <button class="layer-btn" onclick="showAll()">Show All</button>
      <button class="layer-btn" onclick="hideAll()">Hide All</button>
    </div>

    <div class="layer-demo">
      {% for layer in layers %}
      <div class="layer-box z-{{ layer.name }}" id="layer-{{ layer.name }}">
        <span class="layer-box__name">{{ layer.name }}</span>
        <span class="layer-box__value">z("{{ layer.name }}")</span>
        <span class="layer-box__zindex">z-index: {{ layer.z }}</span>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- Stack Diagram -->
  <section>
    <h2>Stack Order</h2>
    <p>Visual representation of the layer stack. Elements are ordered from bottom (canvas) to top (guides). Higher
      z-index values appear in front.</p>

    <div class="stack-diagram">
      <div class="stack-item stack-item--canvas">
        <span>canvas</span>
        <span class="stack-item__z">z-index: -1000</span>
      </div>
      <div class="stack-item stack-item--content">
        <span>content</span>
        <span class="stack-item__z">z-index: 2000</span>
      </div>
      <div class="stack-item stack-item--interface">
        <span>interface</span>
        <span class="stack-item__z">z-index: 4000</span>
      </div>
      <div class="stack-item stack-item--modal">
        <span>modal</span>
        <span class="stack-item__z">z-index: 7000</span>
      </div>
      <div class="stack-item stack-item--guides">
        <span>guides</span>
        <span class="stack-item__z">z-index: 9998</span>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section>
    <h2>Use Cases</h2>
    <p>Each layer is designed for specific UI patterns:</p>

    <div class="use-case-grid">
      <div class="use-case">
        <span class="use-case__layer use-case__layer--guides">guides</span>
        <div class="use-case__title">Development Overlays</div>
        <p class="use-case__examples">Grid guides, alignment helpers, debug overlays, measurement tools</p>
      </div>
      <div class="use-case">
        <span class="use-case__layer use-case__layer--modal">modal</span>
        <div class="use-case__title">Modal Dialogs</div>
        <p class="use-case__examples">Lightboxes, confirmations, image galleries, video players</p>
      </div>
      <div class="use-case">
        <span class="use-case__layer use-case__layer--interface">interface</span>
        <div class="use-case__title">Fixed UI</div>
        <p class="use-case__examples">Sticky headers, navigation bars, toolbars, floating buttons</p>
      </div>
      <div class="use-case">
        <span class="use-case__layer use-case__layer--content">content</span>
        <div class="use-case__title">Main Content</div>
        <p class="use-case__examples">Cards, dropdowns, tooltips, popovers, image overlays</p>
      </div>
      <div class="use-case">
        <span class="use-case__layer use-case__layer--canvas">canvas</span>
        <div class="use-case__title">Background</div>
        <p class="use-case__examples">Page backgrounds, decorative elements, ambient animations</p>
      </div>
    </div>
  </section>

  <!-- Reference Table -->
  <section>
    <h2>Layer Reference</h2>

    <table class="layer-table">
      <thead>
        <tr>
          <th>Layer</th>
          <th>Function</th>
          <th>z-index</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="layer-swatch" style="background: linear-gradient(135deg, #7209b7, #b5179e);"></span>guides
          </td>
          <td><code>z("guides")</code></td>
          <td>9998</td>
          <td>Development guides and debug overlays</td>
        </tr>
        <tr>
          <td><span class="layer-swatch" style="background: linear-gradient(135deg, #d00000, #e85d04);"></span>modal
          </td>
          <td><code>z("modal")</code></td>
          <td>7000</td>
          <td>Modal dialogs, lightboxes, popups</td>
        </tr>
        <tr>
          <td><span class="layer-swatch" style="background: linear-gradient(135deg, #2d6a4f, #40916c);"></span>interface
          </td>
          <td><code>z("interface")</code></td>
          <td>4000</td>
          <td>Fixed navigation, sticky elements</td>
        </tr>
        <tr>
          <td><span class="layer-swatch" style="background: linear-gradient(135deg, #0077b6, #00b4d8);"></span>content
          </td>
          <td><code>z("content")</code></td>
          <td>2000</td>
          <td>Main content with elevation</td>
        </tr>
        <tr>
          <td><span class="layer-swatch" style="background: linear-gradient(135deg, #1a1a2e, #16213e);"></span>canvas
          </td>
          <td><code>z("canvas")</code></td>
          <td>-1000</td>
          <td>Background layer elements</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Usage -->
  <section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// Import the layer function</span>
      @use "unit.gl" as *;

      <span class="comment">// Use semantic layer names instead of magic numbers</span>
      .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: z("modal"); <span class="comment">// 7000</span>
      }

      .sticky-header {
      position: sticky;
      top: 0;
      z-index: z("interface"); <span class="comment">// 4000</span>
      }

      .card {
      position: relative;
      z-index: z("content"); <span class="comment">// 2000</span>
      }

      .background-pattern {
      position: absolute;
      z-index: z("canvas"); <span class="comment">// -1000</span>
      }

      <span class="comment">// Use offsets for related elements</span>
      .dropdown-trigger {
      z-index: z("content"); <span class="comment">// 2000</span>
      }

      .dropdown-menu {
      z-index: z("content") + 10; <span class="comment">// 2010</span>
      }

      .modal-backdrop {
      z-index: z("modal") - 1; <span class="comment">// 6999</span>
      }
    </div>
  </section>

  <!-- Customization -->
  <section>
    <h2>Customization</h2>
    <p>You can extend or modify the default layer map:</p>

    <div class="code-block"><span class="comment">// Add custom layers to $layer_map</span>
      $layer_map: (
      "canvas": -1000,
      "background": 0,
      "content": 2000,
      "dropdown": 3000, <span class="comment">// Custom layer</span>
      "sticky": 3500, <span class="comment">// Custom layer</span>
      "interface": 4000,
      "overlay": 5000, <span class="comment">// Custom layer</span>
      "modal": 7000,
      "toast": 8000, <span class="comment">// Custom layer</span>
      "tooltip": 8500, <span class="comment">// Custom layer</span>
      "guides": 9998,
      ) !default;

      <span class="comment">// Then use your custom layers</span>
      .toast-notification {
      z-index: z("toast"); <span class="comment">// 8000</span>
      }
    </div>
  </section>

  <!-- Best Practices -->
  <section>
    <h2>Best Practices</h2>

    <div class="alert alert--tip">
      <div class="alert__title">Tip</div>
      <p>Use semantic layer names consistently across your project to avoid z-index conflicts and maintain predictable
        stacking behavior.</p>
    </div>

    <ul>
      <li><strong>Never use arbitrary z-index values</strong> — Always use the <code>z()</code> function with semantic
        names</li>
      <li><strong>Use offsets for related elements</strong> — Add +1, +10 for elements that should stack relative to a
        layer</li>
      <li><strong>Keep the gap between layers</strong> — The default 1000-2000 gaps allow plenty of room for offsets
      </li>
      <li><strong>Document custom layers</strong> — If you add layers to <code>$layer_map</code>, document their purpose
      </li>
      <li><strong>Consider stacking contexts</strong> — Remember that <code>position: fixed/absolute</code> with z-index
        creates new stacking contexts</li>
    </ul>
  </section>

</div>

<script>
  function toggleLayer(id) {
    const layer = document.getElementById('layer-' + id);
    const btn = document.getElementById('btn-' + id);

    layer.classList.toggle('layer-box--hidden');
    btn.classList.toggle('layer-btn--active');
  }

  function showAll() {
    document.querySelectorAll('.layer-box').forEach(el => {
      el.classList.remove('layer-box--hidden');
    });
    document.querySelectorAll('.layer-btn').forEach(el => {
      if (el.id.startsWith('btn-')) {
        el.classList.add('layer-btn--active');
      }
    });
  }

  function hideAll() {
    document.querySelectorAll('.layer-box').forEach(el => {
      el.classList.add('layer-box--hidden');
    });
    document.querySelectorAll('.layer-btn').forEach(el => {
      if (el.id.startsWith('btn-')) {
        el.classList.remove('layer-btn--active');
      }
    });
  }
</script>

{%- endblock %}
