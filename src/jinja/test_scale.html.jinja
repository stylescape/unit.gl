{% extends "base.html.jinja" %}

{%- block title %}Kyū Scale Test | unit.gl{%- endblock %}


{%- block header %}
<h1>Scale Test</h1>
<p>Visual tests for typographic and rhythmic scales.</p>
{%- endblock %}

{%- block content %}

<section>
    <h2>Typographic Scale</h2>
    <div class="scale-demo">
        {% for step in [4, 6, 8, 10, 12, 16, 24, 36] %}
        <div class="scale-line" style="font-size: var(--q{{ step }});" data-label="q{{ step }}">
            The quick brown fox jumps.
        </div>
        {% endfor %}
    </div>
</section>

<section>
    <h2>Baseline Scale (Vertical Rhythm)</h2>
    <div class="scale-demo">
        {% for i in range(1, 5) %}
        <div class="scale-line" style="height: calc(var(--q) * {{ i * 5 }});" data-label="baseline({{ i }})">
            The quick brown fox jumps.
        </div>
        {% endfor %}
    </div>
</section>

<section>
    <h2>Basepoint Scale</h2>
    <div class="scale-demo">
        {% for i in range(1, 5) %}
        <div class="scale-line" style="width: calc(var(--q) * {{ i * 4 }});" data-label="basepoint({{ i }})">
            The quick brown fox jumps.
        </div>
        {% endfor %}
    </div>
</section>

{%- endblock %}
